rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      // Profile and gameplay state are server-authoritative.
      // Clients may read their own profile; Cloud Functions/admin perform writes.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/progress/{documentId} {
      allow read: if signedIn()
          && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin()
          || (signedIn()
              && request.auth.uid == userId
              && documentId == 'collection');
    }

    // Game sessions are created and completed only by Cloud Functions.
    // The client must never read or mutate session state directly.
    match /users/{userId}/game_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /users/{userId}/wallet/{walletId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/membership/{membershipId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/purchases/{purchaseId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /purchase_transactions/{transactionId} {
      allow read, write: if false;
    }

    // Security events are server-generated audit records.
    match /security_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Name and player-ID reservations are server-authoritative.
    match /player_names/{nameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /player_ids/{playerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /shop_config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
