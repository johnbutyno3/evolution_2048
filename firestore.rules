rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function profileOnlyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'playerName',
        'playerNameNormalized',
        'playerId',
        'avatarIndex',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
          && request.auth.uid == userId
          && !request.resource.data.keys().hasAny([
            'isAdmin',
            'gold',
            'membership',
            'lives',
            'toolUses',
            'toolInventory',
            'chapterProgress',
            'unlockedChapterIndex'
          ]);
      allow update: if signedIn()
          && (isAdmin() || (request.auth.uid == userId && profileOnlyChanged()));
      allow delete: if isAdmin();
    }

    match /users/{userId}/progress/{documentId} {
      allow read: if signedIn()
          && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /users/{userId}/wallet/{walletId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/membership/{membershipId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/purchases/{purchaseId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /purchase_transactions/{transactionId} {
      allow read, write: if false;
    }

    match /player_names/{nameId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
    }

    match /player_ids/{playerId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
    }

    match /config/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /shop_config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
