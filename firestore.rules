rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
          && request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['isAdmin']);
      allow update: if signedIn()
          && (request.auth.uid == userId || isAdmin())
          && (isAdmin() || request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isAdmin();
    }

    match /users/{userId}/progress/{documentId} {
      allow read, write: if signedIn()
          && (request.auth.uid == userId || isAdmin());
    }

    match /player_names/{nameId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
    }

    match /player_ids/{playerId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
    }

    match /config/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
